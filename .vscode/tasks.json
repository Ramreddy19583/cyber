{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run VWC-MAP Backend (FastAPI)",
      "type": "shell",
      "command": "python3 -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run VWC-MAP Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Run Full VWC-MAP App (Backend + Frontend)",
      "dependsOn": [
        "Run VWC-MAP Backend (FastAPI)",
        "Run VWC-MAP Frontend (Vite)"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
